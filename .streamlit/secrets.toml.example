# Bolão da Cabine do Glória - Secrets do Streamlit
# Copie este arquivo para .streamlit/secrets.toml em desenvolvimento
# No Streamlit Cloud, configure这些 variáveis em App > Settings > Secrets

# Supabase (produção - obrigatório para persistência pública)
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Admin (obrigatório para production - protege a área administrativa)
ADMIN_PASSWORD = "sua-senha-aqui"

# API-Football (opcional)
APIFOOTBALL_KEY = "sua-chave-api-aqui"