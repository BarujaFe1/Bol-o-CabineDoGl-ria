# Bolão da Cabine do Glória - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores necessários

# Supabase (produção)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin (opcional - se não informado, admin fica desprotegido em desenvolvimento)
ADMIN_PASSWORD=sua-senha-aqui

# API-Football (opcional - para sincronização automática de resultados)
APIFOOTBALL_KEY=sua-chave-api-aqui