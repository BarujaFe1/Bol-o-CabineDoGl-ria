          display: none;
        }

        & > div {
          padding-bottom: 26px;
        }
      `}


  }

  @font-face {
    font-family: 'Globotipo Text Regular';
    src: url('https://s3.glbimg.com/v1/AUTH_c631e406debd4c4fac98a09d48dc17d1/cdn/fonts/globotipo/text-regular.ttf')
      format('truetype');
